// The Adire Renova — Supabase Postgres schema
// Pooled connection for runtime; DIRECT_URL for migrations (see .env).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Catalog ----------

model Category {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  position    Int        @default(0)
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Collection {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  imageUrl    String?
  isFeatured  Boolean    @default(false)
  products    ProductCollection[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id           String           @id @default(cuid())
  slug         String           @unique
  name         String
  description  String
  fabricStory  String?
  categoryId   String
  category     Category         @relation(fields: [categoryId], references: [id])
  collections  ProductCollection[]
  instagramPostId String?       @unique
  instagramPost  InstagramPost? @relation(fields: [instagramPostId], references: [id])
  images       ProductImage[]
  variants     ProductVariant[]
  basePriceKobo Int // price in kobo (₦1 = 100 kobo) of smallest variant
  isFeatured   Boolean          @default(false)
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([categoryId, isActive])
}

model ProductCollection {
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String // R2 public URL
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name        String // e.g. "2 yards", "6 yards"
  sku         String   @unique
  priceKobo   Int
  stock       Int      @default(0)
  isDefault   Boolean  @default(false)

  @@index([productId])
}

// ---------- Orders & payments ----------

model Customer {
  id          String    @id @default(cuid())
  email       String?   @unique
  phone       String?   @unique
  fullName    String
  supabaseUid String?   @unique
  addresses   Address[]
  orders      Order[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  state      String
  city       String
  street     String
  landmark   String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

enum OrderStatus {
  pending
  paid
  fulfilled
  shipped
  delivered
  cancelled
  refunded
}

model Order {
  id           String      @id @default(cuid())
  reference    String      @unique // TAR-XXXXXX shown to customer
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  status       OrderStatus @default(pending)
  subtotalKobo Int
  shippingKobo Int         @default(0)
  discountKobo Int         @default(0)
  totalKobo    Int
  shippingAddress Json // { state, city, street, landmark? }
  couponId     String?
  coupon       Coupon?     @relation(fields: [couponId], references: [id])
  placedAt     DateTime    @default(now())

  paidAt       DateTime?
  fulfilledAt  DateTime?
  shippedAt    DateTime?
  deliveredAt  DateTime?
  cancelledAt  DateTime?

  @@index([customerId, placedAt])
  @@index([status])
}

model OrderItem {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId     String
  productName   String // snapshot at time of order
  variantName   String
  unitPriceKobo Int
  quantity      Int
  imageUrl      String?

  @@index([orderId])
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id])
  provider        String   @default("paystack")
  providerRef     String   @unique // Paystack transaction reference
  amountKobo      Int
  status          String   @default("initialized") // initialized | success | failed | abandoned
  gatewayResponse Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([orderId])
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  percentOff   Int?
  amountKobo   Int?
  minSubtotalKobo Int    @default(0)
  maxRedemptions Int?
  redemptions  Int       @default(0)
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  orders       Order[]

  createdAt    DateTime  @default(now())
}

// ---------- Admin ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin") // admin | staff
  createdAt    DateTime @default(now())
}

// ---------- Instagram ----------

model InstagramPost {
  id           String    @id @default(cuid())
  igId         String    @unique
  mediaType    String // image | video | carousel
  mediaUrl     String // R2 URL of downloaded media
  thumbnailUrl String?
  permalink    String?
  caption      String?
  postedAt     DateTime?
  importedAt   DateTime  @default(now())
  product      Product?
}
